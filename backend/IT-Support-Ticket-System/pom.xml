<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        Maven project configuration.

        Maven is responsible for:
        - Managing project dependencies
        - Compiling the Java application
        - Running automated tests
        - Packaging the Spring Boot application
    -->

    <modelVersion>4.0.0</modelVersion>


    <!--
        Spring Boot Parent

        Provides default Maven configuration and compatible
        dependency versions for Spring Boot.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>


    <!--
        Project identification.
    -->
    <groupId>org.example</groupId>

    <artifactId>IT-Support-Ticket-System</artifactId>

    <version>0.0.1-SNAPSHOT</version>

    <name>IT-Support-Ticket-System</name>

    <description>
        Mntungwa ServiceDesk - IT Support Ticket Management System
    </description>


    <!--
        Java configuration.

        The project is developed using Java 21.
    -->
    <properties>
        <java.version>21</java.version>
    </properties>


    <dependencies>

        <!--
            Spring Web

            Provides the tools required to build REST APIs
            and handle HTTP requests such as:

            GET
            POST
            PUT
            DELETE
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>


        <!--
            Spring Data JPA

            Allows the application to communicate with the
            MySQL database using Java objects and repositories.

            It handles operations such as:
            - Save
            - Find
            - Update
            - Delete
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>


        <!--
            MySQL Connector

            Allows Spring Boot to connect to the MySQL database.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!--
            Validation

            Provides validation annotations such as:

            @NotBlank
            @NotNull

            These are used to make sure that incoming
            ticket information is valid.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!--
            Swagger / OpenAPI

            Automatically generates interactive API documentation.

            It provides Swagger UI where we will be able to
            view and test endpoints such as:

            GET    /tickets
            GET    /tickets/{id}
            POST   /tickets
            PUT    /tickets/{id}
            DELETE /tickets/{id}
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.13</version>
        </dependency>


        <!--
            Spring Boot Testing

            Provides tools for automated testing using:

            JUnit
            Mockito
            MockMvc
            Spring Test

            These tools allow us to test the backend without
            manually testing every feature through the browser.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!--
        Spring Boot Maven Plugin

        Allows Maven to:
        - Run the Spring Boot application
        - Package the application
        - Create an executable JAR file
    -->
    <build>

        <plugins>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>